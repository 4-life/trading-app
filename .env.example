# Local development (docker/local/compose.yaml) - copy to .env. Production's
# .env is written by CI from GitHub secrets (README: Production Deploy).

# Dashboard login password - required (README: Security)
APP_PASSWORD=change-me

# Encrypts the exchange API and Telegram keys saved in Settings - required to
# save them; never change it once they're saved. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# Postgres
POSTGRES_USER=trading
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trading

# Ports on this machine (bound to 127.0.0.1)
API_PORT=8000
DASHBOARD_PORT=3000

# Dashboard -> api
API_URL=http://api:8000

# Market data (see docs/market-data.md). The provider and network (Hyperliquid
# or Lighter, mainnet or testnet) are the exchange API added in the app's
# settings - Hyperliquid mainnet until one is added. The perpetuals collected
# live are added in the dashboard (Assets in the header).
# WebSocket auto-reconnect (see docs/market-data.md#websocket-auto-reconnect)
WS_HEALTH_CHECK_SECONDS=30
WS_STALE_SECONDS=120
# Historical backfill on every `docker compose up` (see
# docs/market-data.md#historical-backfill) - history to analyze the market
# from the first run.
BACKFILL_DAYS=220
# Trades and order-book snapshots older than this are deleted hourly (see
# docs/market-data.md#data-retention).
RAW_DATA_RETENTION_HOURS=24
# Scanner papers (see docs/papers.md#scanner-papers): coins scanned (top N by
# 24h volume) and the most papers one scanner keeps enabled.
SCANNER_TOP_N=40
SCANNER_MAX_ACTIVE=10

# The exchange API and the Telegram keys are set in the app's settings and
# stored in the database - not here.
